# Repo-wide ignores only. Layer-specific patterns live next to the layer
# (apps/mobile/.gitignore; apps/api/.gitignore for the future .NET backend).

# dependencies (pnpm creates node_modules at the root and in every workspace)
node_modules/

# build output & caches
dist/
coverage/
.turbo/
*.tsbuildinfo

# env files (local overrides only; never commit secrets)
.env*.local

# credentials — repo-wide safety net for every layer
*.key
*.pem
*.p12

# logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.log*

# OS / editor
.DS_Store
*.orig.*
.idea/
.vscode/*
!.vscode/extensions.json
